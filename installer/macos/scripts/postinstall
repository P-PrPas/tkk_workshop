#!/bin/sh
# Runs as root after the files are copied. $3 is the volume being installed to ("/" on a normal install).
# A package downloaded in a browser carries the quarantine flag; clear it on the installed app so the
# first launch is not blocked again by Gatekeeper.
APP="${3%/}/Applications/TKK Workshop.app"
[ -d "$APP" ] && xattr -dr com.apple.quarantine "$APP" 2>/dev/null
exit 0
