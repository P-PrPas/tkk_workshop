<?xml version="1.0" encoding="utf-8"?>
<!-- productbuild distribution for the macOS installer. @VERSION@ @ARCH@ @MINOS@ are filled in by installer/build.py (arm64 and x86_64 packages differ only in these).
     The Installer app shows the Welcome / Destination / Install / Summary pages in the system language
     (resources/en.lproj, resources/th.lproj; English when the language is neither). -->
<installer-gui-script minSpecVersion="2">
    <title>Cuptick</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="logo.png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="logo.png" alignment="bottomleft" scaling="none"/>
    <options customize="never" require-scripts="false" hostArchitectures="@ARCH@"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="@MINOS@"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Cuptick" description="Cuptick">
        <pkg-ref id="dev.tkk.cuptick"/>
    </choice>
    <pkg-ref id="dev.tkk.cuptick" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
